# BookFlow local development only. Never reuse these values in production.
COMPOSE_PROJECT_NAME=bookflow

# PostgreSQL
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookflow:bookflow_local_only@localhost:5432/bookflow

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO)
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=bookflow-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bookflow-local
STORAGE_ACCESS_KEY_ID=minio_local
STORAGE_SECRET_ACCESS_KEY=minio_local_password
STORAGE_FORCE_PATH_STYLE=true

# Optional local mail catcher
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# API server-only configuration. These local values are intentionally insecure.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=local_access_secret_change_before_any_deployment
JWT_REFRESH_SECRET=local_refresh_secret_change_before_any_deployment

# Worker server-only configuration
WORKER_QUEUE_ENABLED=true
WORKER_CONCURRENCY=5

# Public client configuration. Only *_PUBLIC_* variables may enter client bundles.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
