{
  "name": "@bookflow/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests --exclude '**/*.spec.ts'",
    "test:e2e": "vitest run --passWithNoTests --exclude '**/*.spec.ts'"
  },
  "dependencies": {
    "@bookflow/types": "workspace:*"
  }
}
